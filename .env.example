# VerdictBatch example configuration. Copy to .env only for local tooling.
# Never put a real private key or provider secret in this file.
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_CONTRACT_ADDRESS=0xREPLACE_AFTER_DEPLOY
GENLAYER_ACCOUNT_ADDRESS=0xREPLACE_WITH_STUDIO_ACCOUNT
GENLAYER_ACCOUNT_PRIVATE_KEY=REPLACE_WITH_LOCAL_SECRET
GENLAYER_LLM_PROVIDER=STUDIO_FREE_PROVIDER
GENLAYER_LLM_MODEL=REPLACE_WITH_STUDIO_MODEL
